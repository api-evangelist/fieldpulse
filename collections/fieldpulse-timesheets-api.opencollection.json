              },
              {
                "name": "sort",
                "value": "<array>",
                "type": "query",
                "description": "Array of attribute and order values."
              },
              {
                "name": "rel",
                "value": "<array>",
                "type": "query",
                "description": "array consisting of indices with the desired relation to include"
